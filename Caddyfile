# Caddy sam pribavlja i obnavlja Let's Encrypt certifikat za DOMENA iz .env.
# Meta ne prihvata webhook bez ispravnog HTTPS-a, pa je ovo obavezan dio.

{$DOMENA} {
	encode gzip

	# Dashboard je interni alat; ne treba ga u rezultatima pretrage.
	header /dashboard* -Server
	header /dashboard* X-Robots-Tag "noindex, nofollow"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy app:3001 {
		health_uri /health/live
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}

# Tokovi razgovora. Zaseban domen, a ne putanja na api domenu: n8n gradi
# vlastite webhook adrese iz svog imena hosta, pa mu je najurednije dati ga.
#
# Ovo je alat za upravljanje, ne javni servis — iza Caddya stoji jos i n8n-ova
# vlastita lozinka, a stranica se ne indeksira.
{$N8N_DOMENA} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# n8n je u novijim izdanjima izbacio vlastitu osnovnu prijavu, pa bi bez
	# ovoga i stranica za pravljenje prvog naloga bila otvorena svakome — a ko
	# je prvi stigne, taj postane vlasnik. Zato lozinku trazi Caddy, prije nego
	# sto zahtjev uopste dodje do n8n-a.
	basic_auth {
		{$N8N_KORISNIK} {$N8N_LOZINKA_HASH}
	}

	reverse_proxy n8n:5678
}
