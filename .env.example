# Zajedničko
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://rezora:promijeni-lozinku@localhost:5432/rezora
INTERNAL_API_KEY=promijeni-interni-kljuc
ORCHESTRATION_MODE=backend

# OpenAI - koristi se samo za strukturirano razumijevanje poruke
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true

# QR Agent proizvod
QR_INBOUND_URL=http://localhost:3000/api/v1/channels/qr/inbound
QR_AGENT_TOKEN=promijeni-qr-token
QR_TENANT_ID=00000000-0000-4000-8000-000000000001
QR_CHANNEL_ID=00000000-0000-4000-8000-000000000101
QR_CLIENT_ID=test-bot
QR_AUTH_PATH=.wwebjs_auth
QR_HEADLESS=true
CHROME_EXECUTABLE_PATH=

# Meta Cloud proizvod
META_VERIFY_TOKEN=promijeni-meta-verify-token
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
N8N_META_INBOUND_URL=

# n8n može pozvati internu jezgru ovim ključem
N8N_INTERNAL_API_KEY=promijeni-interni-kljuc

# Šifriranje tajni klijenata u bazi (AES-256-GCM).
# Najmanje 32 znaka. Generisati sa:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NE MIJENJATI nakon što su klijenti uneseni - postojeće tajne se time gube.
SECRETS_KEY=

# Interni dashboard na /dashboard. Korisničko ime je uvijek "rezora".
# Bez ove vrijednosti dashboard je isključen.
DASHBOARD_PASSWORD=

# Javna adresa platforme; koristi se da dashboard ispiše tačan webhook URL
# koji se prepisuje u Meta aplikaciju klijenta. Bez završne kose crte.
PUBLIC_BASE_URL=
